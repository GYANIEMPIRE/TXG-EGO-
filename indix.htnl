<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Tornado Community</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header class="hero">
        <div class="hero-content">
            <div class="badge">TEAM TORNADO</div>

            <h1>Team Tornado <span>Community</span></h1>

            <h2>Copyright Guidance &amp; Account Recovery Information</h2>

            <p>
                Welcome to Team Tornado Community — a simple place for
                digital support, useful information and community updates.
            </p>

            <a href="#contact" class="btn">Contact Admin</a>
        </div>
    </header>

    <main>

        <section class="section">
            <h2>What We Provide</h2>

            <div class="cards">

                <div class="card">
                    <div class="icon">©</div>
                    <h3>Copyright</h3>
                    <p>
                        General copyright information and guidance
                        for digital content.
                    </p>
                </div>

                <div class="card">
                    <div class="icon">↻</div>
                    <h3>Account Recovery</h3>
                    <p>
                        General information and guidance for account
                        recovery processes.
                    </p>
                </div>

                <div class="card">
                    <div class="icon">◆</div>
                    <h3>Community Support</h3>
                    <p>
                        Helpful updates and information for our
                        community members.
                    </p>
                </div>

            </div>
        </section>

        <section class="about">
            <div class="about-box">
                <h2>About Team Tornado</h2>

                <p>
                    Team Tornado Community is focused on providing
                    useful digital information, community updates
                    and general support resources in one place.
                </p>
            </div>
        </section>

        <section class="contact" id="contact">
            <h2>Contact Admin</h2>

            <p>
                For community-related questions and support,
                contact the administrator through the official
                Telegram channel.
            </p>

            <!-- अपना Telegram link यहाँ डालना -->
            <a href="https://t.me/YOUR_CHANNEL" class="btn">
                Contact Admin
            </a>
        </section>

    </main>

    <footer>
        <p>© 2026 Team Tornado Community. All Rights Reserved.</p>
    </footer>

</body>
</html>
